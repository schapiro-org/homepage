{
  // Cloudflare Workers static assets deploy for schapiro.org.
  // This file is the source of truth for the deploy; the Cloudflare dashboard
  // only holds the Git connection and the build settings listed in README.md.
  "name": "schapiro-org-homepage",
  "compatibility_date": "2026-11-05",

  // The schapiro.org zone is on Cloudflare, so deploy provisions the DNS
  // records and certificates. The apex is canonical; www 301-redirects to it
  // via a zone Redirect Rule (see README.md).
  "routes": [
    { "pattern": "www.schapiro.org", "custom_domain": true },
    { "pattern": "schapiro.org", "custom_domain": true }
  ],

  // No plain *.workers.dev production duplicate, but keep per-version
  // preview URLs for PR builds (npx wrangler versions upload).
  "workers_dev": false,
  "preview_urls": true,

  // Static site only, no Worker script. Missing paths get public/404.html.
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page"
  }
}
